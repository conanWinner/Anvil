{
  "name": "anvil",
  "version": "0.5.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "cli": "bun --cwd packages/cli src/cli.ts",
    "dev": "bun --filter '*' dev",
    "dev:server": "bun --filter @anvil/server dev",
    "start": "bun --filter @anvil/server start",
    "build": "bun --filter '*' build",
    "build:binaries": "bash scripts/build-binaries.sh",
    "build:checksums": "bash scripts/checksums.sh",
    "generate:bundled": "bun run scripts/generate-bundled-defaults.ts",
    "check:bundled": "bun run scripts/generate-bundled-defaults.ts --check",
    "check:bundled-skill": "bun run scripts/check-bundled-skill.ts --check",
    "generate:bundled-schema": "bun run scripts/generate-bundled-schema.ts",
    "check:bundled-schema": "bun run scripts/generate-bundled-schema.ts --check",
    "generate:pi-vendor-map": "bun run scripts/generate-pi-vendor-map.ts",
    "check:pi-vendor-map": "bun run scripts/generate-pi-vendor-map.ts --check",
    "migrate:system3-storage": "bun run scripts/migrate-system3-storage-to-workspaces.ts",
    "system3:ml-runtime": "bun run scripts/setup-system3-ml-runtime.ts",
    "system3:ml-lock": "bun run scripts/setup-system3-ml-runtime.ts --lock",
    "test": "bun --filter '*' --sequential test",
    "test:watch": "bun --filter @anvil/server test:watch",
    "type-check": "bun --filter '*' --sequential type-check && bun x tsc --noEmit -p scripts/tsconfig.json",
    "lint": "bun x eslint . --cache",
    "lint:fix": "bun x eslint . --cache --fix",
    "format": "bun x prettier --write .",
    "format:check": "bun x prettier --check .",
    "dev:web": "bun --filter @anvil/web dev",
    "build:web": "bun --filter @anvil/web build",
    "dev:docs": "bun --filter @anvil/docs-web dev",
    "build:docs": "bun --filter @anvil/docs-web build",
    "validate": "bun run check:bundled && bun run check:bundled-skill && bun run check:bundled-schema && bun run check:pi-vendor-map && bun run type-check && bun run lint --max-warnings 0 && bun run format:check && bun run test",
    "prepare": "husky",
    "setup-auth": "bun --filter @anvil/server setup-auth"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/bun": "latest",
    "bun-types": "^1.3.5",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.0",
    "prettier": "^3.7.4",
    "typescript": "^5.3.0",
    "pino-pretty": "^13",
    "typescript-eslint": "^8.48.0"
  },
  "engines": {
    "bun": "^1.3.0"
  },
  "overrides": {
    "test-exclude": "^7.0.1",
    "axios": "^1.15.0",
    "follow-redirects": "^1.16.0",
    "path-to-regexp": "^8.4.2",
    "qs": "^6.15.1",
    "flatted": "^3.4.2",
    "@hono/node-server": "^1.19.13"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.193",
    "@opencode-ai/sdk": "^1.17.3"
  }
}
